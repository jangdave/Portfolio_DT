            int[] primvars:st:indices = [0, 3, 8, 6, 6, 8, 13, 12, 12, 13, 11, 10, 10, 11, 4, 1, 7, 12, 10, 2, 13, 9, 5, 11]
            uniform token subdivisionScheme = "none"
        }
    }

    def Xform "Anchors"
    {
        def Xform "Sensor_SUPPLY_TEMP"
        {
            custom token dct:assetType = "sensor"
            custom token dct:metric = "supply_temp"
            custom string dct:unit = "degC"
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 55, 30)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Xform "Sensor_FAN_SPEED"
